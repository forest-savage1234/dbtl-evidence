{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dbtl-evidence:handoff:0.1-draft",
  "title": "Separate evidence assessments for literature-to-DBTL handoff",
  "description": "Specification draft. Not an implemented importer or a scientific validity certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "origin",
    "producer",
    "sources",
    "quantity",
    "assessments",
    "use_scope"
  ],
  "properties": {
    "schema": {
      "const": "decision-evidence/0.1-draft"
    },
    "evidence_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "literature",
        "local_experiment",
        "simulation",
        "synthetic_fixture"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "code_sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sha256",
          "uri",
          "version",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "measurand",
        "value",
        "unit",
        "basis",
        "estimator",
        "experimental_unit",
        "independence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "proxy_signal",
            "mass_concentration",
            "mass_yield",
            "volumetric_productivity",
            "other"
          ]
        },
        "measurand": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "pattern": "^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "estimator": {
          "type": "string",
          "minLength": 1
        },
        "experimental_unit": {
          "type": "string",
          "minLength": 1
        },
        "independence": {
          "enum": [
            "unresolved",
            "declared",
            "assessed"
          ]
        }
      }
    },
    "assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arithmetic",
        "measurement",
        "sample_identity",
        "replicate_independence",
        "comparability",
        "publication_version"
      ],
      "properties": {
        "arithmetic": {
          "$ref": "#/$defs/assessment"
        },
        "measurement": {
          "$ref": "#/$defs/assessment"
        },
        "sample_identity": {
          "$ref": "#/$defs/assessment"
        },
        "replicate_independence": {
          "$ref": "#/$defs/assessment"
        },
        "comparability": {
          "$ref": "#/$defs/assessment"
        },
        "publication_version": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "use_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_use",
        "target_process",
        "as_of",
        "pool_coverage",
        "pool_snapshot_sha256"
      ],
      "properties": {
        "intended_use": {
          "type": "string",
          "minLength": 1
        },
        "target_process": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "pool_coverage": {
          "enum": [
            "fixed_source_only",
            "bounded_snapshot",
            "unknown"
          ]
        },
        "pool_snapshot_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "basis",
        "source_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "conflict",
            "open",
            "out_of_scope"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
